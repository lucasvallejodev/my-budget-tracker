# Database (the API owns it). Use a URL-safe password in both settings.
DATABASE_URL="postgresql://budget_tracker:CHANGE_ME@localhost:5432/budget_tracker"
POSTGRES_USER=budget_tracker
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=budget_tracker
POSTGRES_PORT=5432

# API (apps/api). Defaults shown; see docs/architecture/api.md › Configuration.
API_HOST=127.0.0.1
API_PORT=4000
# Origins allowed to send writes: the public URL of the web app.
ALLOWED_ORIGINS=http://localhost:3000
# Origins allowed to read responses cross-origin. Empty keeps CORS closed.
CORS_ORIGINS=
# Secure cookies need HTTPS. Leave unset to follow NODE_ENV (on in production).
COOKIE_SECURE=
SESSION_DAYS=30
AUTH_ATTEMPTS_PER_MINUTE=10
TRUST_PROXY=true
LOG_LEVEL=info

# Web (apps/web). Where Next.js forwards /api/*; read when the web app is built.
API_URL=http://127.0.0.1:4000
