# Database (the API owns it). Use a URL-safe password in both settings.
DATABASE_URL="postgresql://budget_tracker:CHANGE_ME@localhost:5432/budget_tracker"
POSTGRES_USER=budget_tracker
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=budget_tracker
POSTGRES_PORT=5432

# API (apps/api). Defaults shown; see docs/architecture/api.md › Configuration.
API_HOST=127.0.0.1
API_PORT=4000
# Origins allowed to send writes: the public URL of the web app.
ALLOWED_ORIGINS=http://localhost:3000
# Origins allowed to read responses cross-origin. Empty keeps CORS closed.
CORS_ORIGINS=
# Secure cookies need HTTPS. Leave unset to follow NODE_ENV (on in production and in
# Docker Compose); set false only to try the Compose stack over plain HTTP.
COOKIE_SECURE=
SESSION_DAYS=30
# Absolute session age in days, however often it is used (at least SESSION_DAYS).
SESSION_MAX_AGE_DAYS=90
AUTH_ATTEMPTS_PER_MINUTE=10
# Wrong passwords per email before its sign-in attempts are slowed (1 s growing to 5 s apart; never a lock).
SIGN_IN_FAILURES_PER_ACCOUNT=5
# Proxies whose X-Forwarded-For is believed: false, or addresses/CIDRs/loopback/uniquelocal.
# Only set it when the web app is reachable solely through your reverse proxy.
TRUST_PROXY=false
# Longest a request may run before the API answers 503 (ms, 1000-120000).
# Keep it below the Next.js proxy timeout (30 s).
HANDLER_TIMEOUT_MS=20000
LOG_LEVEL=info

# Web (apps/web). Where Next.js forwards /api/*; read when the web app is built.
API_URL=http://127.0.0.1:4000
# Docker Compose: host address the web container is published on (loopback by default).
WEB_BIND_ADDRESS=127.0.0.1

# Docker Compose backups (docs/getting-started/setup.md › Backups): where dated dumps go, how
# many days they are kept, and the host user that owns them (run id -u and id -g on Linux).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_UID=1000
BACKUP_GID=1000
