{
  "name": "coinkeeper",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:check": "npm run db:check -w @coinkeeper/api",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @coinkeeper/api",
    "db:migrate": "npm run db:migrate -w @coinkeeper/api",
    "db:seed:demo": "npm run db:seed:demo -w @coinkeeper/api",
    "db:studio": "npm run db:studio -w @coinkeeper/api",
    "db:up": "docker compose up -d postgres",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @coinkeeper/api",
    "dev:web": "npm run dev -w @coinkeeper/web",
    "docs": "npx -y docsify-cli serve docs --port 3010",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint . && stylelint \"apps/web/src/**/*.scss\"",
    "lint:dupes": "jscpd apps packages",
    "lint:fix": "eslint --fix . && stylelint --fix \"apps/web/src/**/*.scss\"",
    "start": "npm run start -w @coinkeeper/web",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text-summary",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "user:reset-password": "npm run user:reset-password -w @coinkeeper/api --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.7",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
