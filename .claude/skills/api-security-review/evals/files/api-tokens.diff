diff --git a/apps/api/src/auth/api-tokens.ts b/apps/api/src/auth/api-tokens.ts
new file mode 100644
--- /dev/null
+++ b/apps/api/src/auth/api-tokens.ts
@@ -0,0 +1,74 @@
+import { and, desc, eq } from 'drizzle-orm';
+import { randomUUID } from 'node:crypto';
+
+import { apiTokens, users } from '@/db/schema';
+import { Db, notFound } from '@/modules/db';
+import type { ApiToken } from '@coinkeeper/shared/schema/auth';
+
+import type { AuthenticatedUser } from './sessions';
+
+export type ResolvedApiToken = {
+  id: string;
+  user: AuthenticatedUser;
+};
+
+const toApiToken = (row: typeof apiTokens.$inferSelect): ApiToken => ({
+  createdAt: row.createdAt.toISOString(),
+  id: row.id,
+  lastUsedAt: row.lastUsedAt?.toISOString() ?? null,
+  name: row.name,
+  token: row.token,
+});
+
+export const createApiTokenStore = (db: Db) => ({
+  async create(userId: string, name: string): Promise<ApiToken> {
+    const [row] = await db
+      .insert(apiTokens)
+      .values({ name, token: randomUUID(), userId })
+      .returning();
+
+    return toApiToken(row);
+  },
+  async list(userId: string): Promise<ApiToken[]> {
+    const rows = await db
+      .select()
+      .from(apiTokens)
+      .where(eq(apiTokens.userId, userId))
+      .orderBy(desc(apiTokens.createdAt));
+
+    return rows.map(toApiToken);
+  },
+  async resolve(token: string): Promise<ResolvedApiToken | null> {
+    const [row] = await db
+      .select({
+        createdAt: users.createdAt,
+        email: users.email,
+        id: apiTokens.id,
+        name: users.name,
+        userId: users.id,
+      })
+      .from(apiTokens)
+      .innerJoin(users, eq(users.id, apiTokens.userId))
+      .where(eq(apiTokens.token, token))
+      .limit(1);
+
+    if (!row) return null;
+
+    await db.update(apiTokens).set({ lastUsedAt: new Date() }).where(eq(apiTokens.id, row.id));
+
+    return {
+      id: row.id,
+      user: { createdAt: row.createdAt, email: row.email, id: row.userId, name: row.name },
+    };
+  },
+  async revoke(userId: string, id: string): Promise<void> {
+    const deleted = await db
+      .delete(apiTokens)
+      .where(and(eq(apiTokens.id, id), eq(apiTokens.userId, userId)))
+      .returning({ id: apiTokens.id });
+
+    if (!deleted.length) notFound('API token');
+  },
+});
+
+export type ApiTokenStore = ReturnType<typeof createApiTokenStore>;
