diff --git a/apps/api/src/plugins/server-timing.ts b/apps/api/src/plugins/server-timing.ts
new file mode 100644
index 0000000..e7fb4f2
--- /dev/null
+++ b/apps/api/src/plugins/server-timing.ts
@@ -0,0 +1,29 @@
+import type { FastifyInstance } from 'fastify';
+
+const SERVER_TIMING_HEADER = 'server-timing';
+const DURATION_DECIMALS = 1;
+
+type RequestTiming = {
+  startedAt: number;
+};
+
+declare module 'fastify' {
+  interface FastifyRequest {
+    timing: RequestTiming;
+  }
+}
+
+const serverTimingOf = (timing: RequestTiming): string =>
+  `app;dur=${(performance.now() - timing.startedAt).toFixed(DURATION_DECIMALS)}`;
+
+export const registerServerTiming = async (app: FastifyInstance): Promise<void> => {
+  app.decorateRequest('timing', { startedAt: 0 });
+
+  app.addHook('onRequest', async request => {
+    request.timing.startedAt = performance.now();
+  });
+
+  app.addHook('onResponse', async (request, reply) => {
+    reply.header(SERVER_TIMING_HEADER, serverTimingOf(request.timing));
+  });
+};
