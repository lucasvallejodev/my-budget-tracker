diff --git a/apps/api/src/modules/fx/sync.ts b/apps/api/src/modules/fx/sync.ts
new file mode 100644
index 0000000..c1c9a91
--- /dev/null
+++ b/apps/api/src/modules/fx/sync.ts
@@ -0,0 +1,58 @@
+import { sql } from 'drizzle-orm';
+
+import { exchangeRates } from '@/db/schema';
+import type {
+  ExchangeRateSyncQuery,
+  ExchangeRateSyncResult,
+} from '@coinkeeper/shared/schema/exchange-rates';
+
+import { Db, ServiceError } from '../db';
+import type { RateQuote } from './provider';
+
+const DEFAULT_SYNC_DAYS = 7;
+const PROVIDER_FAILED_STATUS = 502;
+
+const RateKeyColumns = [
+  exchangeRates.userId,
+  exchangeRates.base,
+  exchangeRates.quote,
+  exchangeRates.date,
+];
+
+export type RemoteRates = (base: string, days: number) => Promise<RateQuote[]>;
+
+const toRow = (userId: string, quote: RateQuote) => ({
+  base: quote.base,
+  date: quote.date,
+  quote: quote.quote,
+  rate: String(quote.rate),
+  source: quote.source,
+  userId,
+});
+
+export const createRateSyncService = (db: Db, fetchRemoteRates: RemoteRates) => ({
+  async sync(userId: string, query: ExchangeRateSyncQuery): Promise<ExchangeRateSyncResult> {
+    const quotes = await fetchRemoteRates(query.base, query.days ?? DEFAULT_SYNC_DAYS).catch(() => {
+      throw new ServiceError(
+        'The exchange rate provider is not responding. Try again in a few minutes.',
+        PROVIDER_FAILED_STATUS
+      );
+    });
+
+    if (!quotes.length) return { saved: 0, skipped: 0 };
+
+    const rows = quotes.map(quote => toRow(userId, quote));
+    const insert = db.insert(exchangeRates).values(rows);
+
+    const saved = query.overwrite
+      ? await insert
+          .onConflictDoUpdate({
+            set: { rate: sql`excluded.rate`, source: sql`excluded.source` },
+            target: RateKeyColumns,
+          })
+          .returning({ date: exchangeRates.date })
+      : await insert.onConflictDoNothing().returning({ date: exchangeRates.date });
+
+    return { saved: saved.length, skipped: rows.length - saved.length };
+  },
+});
