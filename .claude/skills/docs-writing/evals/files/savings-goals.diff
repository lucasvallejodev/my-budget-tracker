+'use client';
+
+import { useMutation } from '@tanstack/react-query';
+import { useState } from 'react';
+import { toast } from 'sonner';
+
+import { deleteSavingsGoal, restoreSavingsGoal } from '@/api/mutations';
+import {
+  Badge,
+  Button,
+  Cluster,
+  EmptyState,
+  Grid,
+  Page,
+  PageHeading,
+  ProgressBar,
+  QueryContent,
+  Text,
+} from '@/components/ui';
+import { formatMoney } from '@coinkeeper/shared/lib/money';
+
+import { SavingsGoalRow, useRefreshFinance, useSavingsGoals } from '../use-finance-data';
+import { SavingsGoalDialog } from './savings-goal-dialog';
+
+function GoalCard({
+  goal,
+  onDelete,
+  onEdit,
+}: {
+  goal: SavingsGoalRow;
+  onDelete: () => void;
+  onEdit: () => void;
+}) {
+  const saved = formatMoney(goal.savedMinor, goal.currency);
+  const target = formatMoney(goal.targetMinor, goal.currency);
+
+  return (
+    <article>
+      <Cluster justify="between">
+        <div>
+          <h3>{goal.name}</h3>
+          <Text tone="muted">
+            {goal.accountName} · Saved {saved} of {target}
+            {goal.targetDate ? ` · By ${goal.targetDate}` : ''}
+          </Text>
+        </div>
+        <Badge tone={goal.reached ? 'success' : 'neutral'}>
+          {goal.reached ? 'Reached' : 'In progress'}
+        </Badge>
+      </Cluster>
+      <ProgressBar
+        label={`${goal.name} progress`}
+        max={goal.targetMinor}
+        value={Math.max(goal.savedMinor, 0)}
+      />
+      <Cluster>
+        <Button variant="outline" size="sm" onClick={onEdit}>
+          Edit
+        </Button>
+        <Button variant="destructive" size="sm" onClick={onDelete}>
+          Delete
+        </Button>
+      </Cluster>
+    </article>
+  );
+}
+
+export function SavingsGoals() {
+  const goals = useSavingsGoals();
+  const refresh = useRefreshFinance();
+  const [editing, setEditing] = useState<Partial<SavingsGoalRow> | null>(null);
+
+  const remove = useMutation({
+    mutationFn: deleteSavingsGoal,
+    onError: (error: Error) => toast.error(error.message),
+    onSuccess: (_, id) => {
+      refresh();
+      toast.success('Goal deleted', {
+        action: { label: 'Undo', onClick: () => void restoreSavingsGoal(id).then(refresh) },
+      });
+    },
+  });
+
+  return (
+    <Page>
+      <PageHeading
+        title="Goals"
+        description="Track what you are saving for in a savings account."
+        action={<Button onClick={() => setEditing({})}>New goal</Button>}
+      />
+      <QueryContent query={goals}>
+        {items =>
+          items.length === 0 ? (
+            <EmptyState
+              title="No goals yet"
+              description="Link a goal to a savings account to see how far you are."
+            />
+          ) : (
+            <Grid>
+              {items.map(goal => (
+                <GoalCard
+                  key={goal.id}
+                  goal={goal}
+                  onEdit={() => setEditing(goal)}
+                  onDelete={() => remove.mutate(goal.id)}
+                />
+              ))}
+            </Grid>
+          )
+        }
+      </QueryContent>
+      {editing && (
+        <SavingsGoalDialog
+          goal={editing}
+          onClose={() => setEditing(null)}
+          onSaved={() => {
+            setEditing(null);
+            refresh();
+          }}
+        />
+      )}
+    </Page>
+  );
+}
