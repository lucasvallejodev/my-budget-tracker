+import { z } from 'zod';
+
+import { FieldLengths } from '../constants/field-lengths';
+import { Patterns } from '../lib/patterns';
+import { deletedQuerySchema, isoDateSchema } from './common';
+
+export const savingsGoalFormSchema = z.object({
+  accountId: z.uuid('Choose a savings account'),
+  color: z.string().regex(Patterns.hexColor, 'Choose a colour'),
+  name: z.string().trim().min(1, 'Name is required').max(FieldLengths.name),
+  targetAmount: z.string().trim().min(1, 'Target is required').max(FieldLengths.amountInput),
+  targetDate: isoDateSchema.nullable(),
+});
+
+export type SavingsGoalFormValues = z.infer<typeof savingsGoalFormSchema>;
+
+export const savingsGoalPatchSchema = savingsGoalFormSchema.omit({ accountId: true }).partial();
+
+export const savingsGoalRowSchema = z.object({
+  accountId: z.string(),
+  accountName: z.string(),
+  color: z.string(),
+  currency: z.string(),
+  deletedAt: z.string().nullable(),
+  id: z.string(),
+  name: z.string(),
+  reached: z.boolean(),
+  savedMinor: z.number().int(),
+  targetDate: z.string().nullable(),
+  targetMinor: z.number().int(),
+});
+
+export type SavingsGoalRow = z.infer<typeof savingsGoalRowSchema>;
+
+export const savingsGoalListQuerySchema = deletedQuerySchema;
