diff --git a/apps/api/src/modules/savings-goals/service.ts b/apps/api/src/modules/savings-goals/service.ts
new file mode 100644
index 0000000..f4e2ecc
--- /dev/null
+++ b/apps/api/src/modules/savings-goals/service.ts
@@ -0,0 +1,136 @@
+import { and, asc, eq, inArray, isNotNull, isNull, sql } from 'drizzle-orm';
+
+import { accounts, savingsGoals, transactions } from '@/db/schema';
+import type { SavingsGoalRow } from '@coinkeeper/shared/schema/savings-goals';
+
+import { Db, notFound, ServiceError, toIsoTimestamp } from '../db';
+
+type GoalInput = {
+  accountId: string;
+  color: string;
+  name: string;
+  targetDate: string | null;
+  targetMinor: number;
+};
+
+type GoalPatch = Partial<Omit<GoalInput, 'accountId'>>;
+
+type ListOptions = { deleted?: boolean; ids?: string[] };
+
+const assertPositiveTarget = (targetMinor: number | undefined) => {
+  if (targetMinor !== undefined && targetMinor <= 0) {
+    throw new ServiceError('The target must be a positive amount');
+  }
+};
+
+export const createSavingsGoalService = (db: Db) => {
+  const ownedGoal = async (userId: string, id: string, deleted: boolean) => {
+    const [goal] = await db
+      .select()
+      .from(savingsGoals)
+      .where(
+        and(
+          eq(savingsGoals.id, id),
+          eq(savingsGoals.userId, userId),
+          deleted ? isNotNull(savingsGoals.deletedAt) : isNull(savingsGoals.deletedAt)
+        )
+      )
+      .limit(1);
+
+    return goal ?? notFound('Savings goal');
+  };
+
+  const list = async (userId: string, options: ListOptions = {}): Promise<SavingsGoalRow[]> => {
+    const rows = await db
+      .select({
+        accountId: savingsGoals.accountId,
+        accountName: accounts.name,
+        color: savingsGoals.color,
+        currency: savingsGoals.currency,
+        deletedAt: savingsGoals.deletedAt,
+        id: savingsGoals.id,
+        name: savingsGoals.name,
+        savedMinor: sql<string>`COALESCE((SELECT sum(t.amount_minor) FROM ${transactions} t WHERE t.account_id = ${savingsGoals.accountId} AND t.deleted_at IS NULL), 0)`,
+        targetDate: savingsGoals.targetDate,
+        targetMinor: savingsGoals.targetMinor,
+      })
+      .from(savingsGoals)
+      .innerJoin(accounts, eq(accounts.id, savingsGoals.accountId))
+      .where(
+        and(
+          eq(savingsGoals.userId, userId),
+          options.deleted ? isNotNull(savingsGoals.deletedAt) : isNull(savingsGoals.deletedAt),
+          options.ids ? inArray(savingsGoals.id, options.ids) : undefined
+        )
+      )
+      .orderBy(asc(savingsGoals.createdAt));
+
+    return rows.map(row => {
+      const savedMinor = Number(row.savedMinor);
+
+      return {
+        ...row,
+        deletedAt: toIsoTimestamp(row.deletedAt),
+        reached: savedMinor >= row.targetMinor,
+        savedMinor,
+      };
+    });
+  };
+
+  const rowOf = async (userId: string, id: string): Promise<SavingsGoalRow> => {
+    const [row] = await list(userId, { ids: [id] });
+
+    return row ?? notFound('Savings goal');
+  };
+
+  const create = async (userId: string, input: GoalInput) => {
+    assertPositiveTarget(input.targetMinor);
+
+    const [account] = await db
+      .select()
+      .from(accounts)
+      .where(
+        and(
+          eq(accounts.id, input.accountId),
+          eq(accounts.userId, userId),
+          isNull(accounts.deletedAt)
+        )
+      )
+      .limit(1);
+
+    if (!account) return notFound('Account');
+
+    if (account.archivedAt) throw new ServiceError('Choose an account that is not archived');
+
+    const [goal] = await db
+      .insert(savingsGoals)
+      .values({ ...input, currency: account.currency, userId })
+      .returning({ id: savingsGoals.id });
+
+    return rowOf(userId, goal.id);
+  };
+
+  const update = async (userId: string, id: string, patch: GoalPatch) => {
+    assertPositiveTarget(patch.targetMinor);
+    await ownedGoal(userId, id, false);
+
+    await db.update(savingsGoals).set(patch).where(eq(savingsGoals.id, id));
+
+    return rowOf(userId, id);
+  };
+
+  const remove = async (userId: string, id: string) => {
+    await ownedGoal(userId, id, false);
+    await db.update(savingsGoals).set({ deletedAt: new Date() }).where(eq(savingsGoals.id, id));
+  };
+
+  const restore = async (userId: string, id: string) => {
+    await ownedGoal(userId, id, true);
+
+    await db.update(savingsGoals).set({ deletedAt: null }).where(eq(savingsGoals.id, id));
+
+    return rowOf(userId, id);
+  };
+
+  return { create, list, remove, restore, update };
+};
