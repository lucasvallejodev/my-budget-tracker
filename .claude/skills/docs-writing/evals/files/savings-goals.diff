+'use client';
+
+import { useState } from 'react';
+
+import { createSavingsGoal, updateSavingsGoal } from '@/api/mutations';
+import {
+  Button,
+  ColorPicker,
+  Dialog,
+  DialogContent,
+  DialogTitle,
+  Field,
+  FormStack,
+  Input,
+} from '@/components/ui';
+import { Colors } from '@/styles/theme';
+import { minorToDecimalString } from '@coinkeeper/shared/lib/money';
+
+import { AccountPicker } from '../account-picker';
+import { useEntityMutation } from '../use-entity-mutation';
+import { SavingsGoalRow } from '../use-finance-data';
+
+export function SavingsGoalDialog({
+  goal,
+  onClose,
+  onSaved,
+}: {
+  goal: Partial<SavingsGoalRow>;
+  onClose: () => void;
+  onSaved: () => void;
+}) {
+  const [name, setName] = useState(goal.name ?? '');
+  const [color, setColor] = useState(goal.color ?? Colors.primary);
+  const [accountId, setAccountId] = useState(goal.accountId);
+  const [targetDate, setTargetDate] = useState(goal.targetDate ?? '');
+
+  const [targetAmount, setTargetAmount] = useState(
+    goal.targetMinor && goal.currency ? minorToDecimalString(goal.targetMinor, goal.currency) : ''
+  );
+
+  const values = { color, name, targetAmount, targetDate: targetDate || null };
+
+  const save = useEntityMutation({
+    mutationFn: () =>
+      goal.id
+        ? updateSavingsGoal(goal.id, values)
+        : createSavingsGoal({ ...values, accountId: accountId! }),
+    onSuccess: onSaved,
+    successMessage: 'Goal saved',
+  });
+
+  return (
+    <Dialog open onOpenChange={open => !open && onClose()}>
+      <DialogContent>
+        <DialogTitle>{goal.id ? 'Edit goal' : 'New goal'}</DialogTitle>
+        <FormStack
+          onSubmit={event => {
+            event.preventDefault();
+            save.mutate();
+          }}
+        >
+          <Field>
+            Name
+            <Input value={name} onChange={event => setName(event.target.value)} />
+          </Field>
+          <Field as="div">
+            Colour
+            <ColorPicker value={color} onChange={setColor} />
+          </Field>
+          <Field as="div">
+            Savings account
+            <AccountPicker value={accountId} onChange={setAccountId} disabled={!!goal.id} />
+          </Field>
+          <Field>
+            Target amount
+            <Input
+              inputMode="decimal"
+              value={targetAmount}
+              onChange={event => setTargetAmount(event.target.value)}
+            />
+          </Field>
+          <Field>
+            Target date (optional)
+            <Input
+              type="date"
+              value={targetDate}
+              onChange={event => setTargetDate(event.target.value)}
+            />
+          </Field>
+          <Button type="submit" disabled={save.isPending}>
+            Save goal
+          </Button>
+        </FormStack>
+      </DialogContent>
+    </Dialog>
+  );
+}
