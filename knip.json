{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "e2e/**/*.ts"
      ]
    },
    "apps/web": {},
    "packages/shared": {
      "entry": [
        "src/**/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "src/server.ts",
        "src/cli/*.ts",
        "scripts/*.mjs"
      ]
    }
  }
}
