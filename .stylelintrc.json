{
  "customSyntax": "postcss-scss",
  "ignoreFiles": [
    "apps/web/src/styles/tokens.scss",
    "apps/web/src/styles/theme/**",
    "**/node_modules/**",
    "**/.next/**",
    ".claude/worktrees/**"
  ],
  "plugins": [
    "./scripts/stylelint-rules/bem-block-matches-file.mjs",
    "./scripts/stylelint-rules/require-layer.mjs"
  ],
  "rules": {
    "color-no-hex": [
      true,
      {
        "message": "Hard-coded colour. Add it to the theme in apps/web/src/styles/theme/ and use var(--color-…) or color(name)."
      }
    ],
    "color-named": [
      "never",
      {
        "message": "Named colour. Add it to the theme in apps/web/src/styles/theme/ and use var(--color-…) or color(name)."
      }
    ],
    "function-disallowed-list": [
      [
        "rgb",
        "rgba",
        "hsl",
        "hsla"
      ],
      {
        "message": "Colour function. Add it to the theme in apps/web/src/styles/theme/ and use var(--color-…) or color(name)."
      }
    ],
    "rule-empty-line-before": [
      "always",
      {
        "except": [
          "first-nested"
        ],
        "ignore": [
          "after-comment"
        ]
      }
    ],
    "at-rule-empty-line-before": [
      "always",
      {
        "except": [
          "first-nested",
          "blockless-after-same-name-blockless"
        ],
        "ignore": [
          "after-comment"
        ],
        "ignoreAtRules": [
          "else"
        ]
      }
    ],
    "declaration-empty-line-before": [
      "always",
      {
        "except": [
          "after-declaration",
          "first-nested"
        ],
        "ignore": [
          "after-comment",
          "inside-single-line-block"
        ]
      }
    ],
    "declaration-property-value-allowed-list": [
      {
        "font-size": [
          "/^(\\$|font-size\\(|var\\(--font-size-|inherit$)/"
        ],
        "font-weight": [
          "/^(font-weight\\(|var\\(--font-weight-|inherit$)/"
        ],
        "font-family": [
          "/^(var\\(--font-(sans|mono)\\)|inherit$)/"
        ],
        "box-shadow": [
          "/^(shadow\\(|var\\(--shadow-|none$)/"
        ],
        "z-index": [
          "/^(z-index\\(|var\\(--z-index-|auto$|0$)/"
        ],
        "letter-spacing": [
          "/^(letter-spacing\\(|var\\(--letter-spacing-|normal$|0$)/"
        ],
        "line-height": [
          "/^(line-height\\(|var\\(--line-height-|1$|inherit$|normal$)/"
        ],
        "/radius$/": [
          "/^(\\$|radius\\(|var\\(--radius-|0$|inherit$)/"
        ],
        "/^transition(-duration)?$/": [
          "/(duration\\(|var\\(--duration-)|^none$/"
        ],
        "/^border(-(top|right|bottom|left|block|inline)(-(start|end))?)?$/": [
          "/^(border\\(|var\\(--|0$|none$)/"
        ]
      },
      {
        "message": "Design value outside the theme. Use the theme functions (font-size(), font-weight(), radius(), shadow(), z-index(), border(), duration()) or var(--…) from apps/web/src/styles/theme/."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/web/src/components/**/*.scss"
      ],
      "rules": {
        "at-rule-disallowed-list": [
          [
            "extend"
          ],
          {
            "message": "@extend couples blocks. Reuse a mixin from apps/web/src/styles/abstracts or compose components."
          }
        ],
        "declaration-no-important": true,
        "local/bem-block-matches-file": true,
        "max-nesting-depth": [
          2,
          {
            "ignore": [
              "pseudo-classes"
            ],
            "ignoreAtRules": [
              "include",
              "media",
              "layer",
              "supports"
            ]
          }
        ],
        "media-feature-name-disallowed-list": [
          [
            "width",
            "min-width",
            "max-width"
          ],
          {
            "message": "Use the breakpoint mixins (media-up, media-down, media-between) from apps/web/src/styles/abstracts."
          }
        ],
        "selector-class-pattern": [
          "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
          {
            "message": "Class names follow BEM in kebab-case: block, block__element, block--modifier, block__element--modifier.",
            "resolveNestedSelectors": true
          }
        ],
        "selector-max-compound-selectors": 2,
        "selector-max-id": 0,
        "selector-max-type": [
          0,
          {
            "ignoreTypes": [
              "svg"
            ],
            "message": "Give the element a BEM class (block__element) instead of styling a tag."
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/components/ui/**/*.scss"
      ],
      "rules": {
        "local/require-layer": "ui"
      }
    }
  ]
}
